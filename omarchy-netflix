#!/bin/bash
set -euo pipefail

fail() {
  printf '%s\n' "$1" >&2
  if command -v notify-send >/dev/null 2>&1; then
    notify-send 'Netflix (Unofficial)' "$1" || true
  fi
  exit 1
}

case ${1:-} in
  --help) printf '%s\n' 'Open Netflix in a dedicated Google Chrome app window.'; exit 0 ;;
  '') ;;
  *) fail 'This launcher does not accept URLs or browser options.' ;;
esac
(( $# <= 1 )) || fail 'Unexpected arguments.'

browser=''
for candidate in google-chrome-stable google-chrome; do
  if command -v "$candidate" >/dev/null 2>&1; then
    browser=$(command -v "$candidate")
    break
  fi
done
[[ -n $browser ]] || fail 'Google Chrome is required. Install it through Omarchy, then open Netflix again.'

config=${XDG_CONFIG_HOME:-}
[[ $config == /* ]] || config="$HOME/.config"
profile="$config/omarchy-netflix/chrome"
umask 077
mkdir -p -- "$profile"
args=("--user-data-dir=$profile" '--class=omarchy-netflix' '--app=https://www.netflix.com/' '--no-first-run' '--no-default-browser-check')
# Preserve Chrome sandboxing and GPU defaults. Never disable the sandbox for DRM.
if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v uwsm-app >/dev/null 2>&1; then
  exec uwsm-app -- "$browser" "${args[@]}"
fi
exec "$browser" "${args[@]}"

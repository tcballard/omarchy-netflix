#!/bin/bash
set -euo pipefail

fail() {
  printf '%s\n' "$1" >&2
  if command -v notify-send >/dev/null 2>&1; then
    notify-send 'Netflix (Unofficial)' "$1" || true
  fi
  exit 1
}

case ${1:-} in
  --help) printf '%s\n' 'Open Netflix in a dedicated Chromium window.'; exit 0 ;;
  --version) printf '%s\n' 'omarchy-netflix 0.1.0'; exit 0 ;;
  '') ;;
  *) fail 'This launcher does not accept URLs or browser options.' ;;
esac
(( $# <= 1 )) || fail 'Unexpected arguments.'

browser=$(command -v chromium || true)
[[ -n $browser ]] || fail 'Chromium is required. Install it through Omarchy, then open Netflix again.'

config=${XDG_CONFIG_HOME:-}
[[ $config == /* ]] || config="$HOME/.config"
profile="$config/omarchy-netflix/chrome"
umask 077
mkdir -p -- "$profile"
args=("--user-data-dir=$profile" '--class=omarchy-netflix' '--new-window' '--no-first-run' '--no-default-browser-check' 'https://www.netflix.com/')
# Use the same normal-window path verified for protected Chromium playback.
# Preserve sandboxing and GPU defaults; never disable the sandbox for DRM.
if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v uwsm-app >/dev/null 2>&1; then
  exec uwsm-app -- "$browser" "${args[@]}"
fi
exec "$browser" "${args[@]}"
